/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'
  X-Frame-Options: DENY

# Vite names built files by their content hash, so a new build never reuses a name.
/ramascene-explorer/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public data (CC BY 4.0): any origin may read it, as on the R2 data host.
/ramascene-explorer/data/*
  Access-Control-Allow-Origin: *

/ramascene-explorer/geo/*
  Cache-Control: public, max-age=86400
