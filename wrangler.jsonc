{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The live site: simonvanlierde.com/ramascene-explorer. The domain's other pages stay on
  // GitHub Pages. cloudflare.yml uploads each main build as a version and checks it on its
  // version URL before serving it. Pull request previews are their own Workers, from
  // wrangler.preview.jsonc (docs/publishing.md#cloudflare).
  // Static assets only: the page reads the large data from DATA_ORIGIN (docs/publishing.md#data-host).
  "name": "ramascene-explorer",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "simonvanlierde.com/ramascene-explorer", "zone_name": "simonvanlierde.com" },
    { "pattern": "simonvanlierde.com/ramascene-explorer/*", "zone_name": "simonvanlierde.com" }
  ],
  // pnpm build:cloudflare builds into site/ramascene-explorer/, so asset paths are the
  // public paths, and _headers matches those.
  "assets": {
    "directory": "site",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
