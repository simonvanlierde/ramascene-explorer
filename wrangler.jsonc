{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ramascene-explorer-staging",
  "main": "hosting/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/data/embodied.parquet", "/data/browser-engine/store-*/*"],
    "not_found_handling": "none"
  },
  "r2_buckets": [
    { "binding": "EMBODIED", "bucket_name": "ramascene-explorer-data" }
  ],
  "observability": { "enabled": true }
}
