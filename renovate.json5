{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Digest pins for actions and config-migration PRs.
    "config:best-practices",
    ":semanticCommits",
    "schedule:monthly",
    // Minor and patch in one PR. Majors stay separate.
    "group:allNonMajor",
  ],

  // config:best-practices brings this preset, a 3-day rule for npm that beats the
  // 7 days below, so Renovate proposed npm releases pnpm still refuses.
  ignorePresets: ["security:minimumReleaseAgeNpm"],

  // A week gives a hijacked release time to be yanked.
  minimumReleaseAge: "7 days",

  // A lock refresh has no release date, so minimumReleaseAge would hold it at
  // renovate/stability-days for good. pnpm's minimumReleaseAge and uv's exclude-newer keep releases younger than a
  // week out of the refresh instead.
  lockFileMaintenance: { minimumReleaseAge: null },

  // Renovate merges once every check on the branch passes. GitHub's own
  // auto-merge would wait only for the four checks main requires. Renovate's
  // app bypasses main's required review, so its merges need no approval.
  platformAutomerge: false,

  packageRules: [
    // brightway-check/ records results from its exact Brightway pins. A rule,
    // not ignorePaths, which would replace the preset's default ignore list.
    {
      matchFileNames: ["brightway-check/**"],
      enabled: false,
    },
    // A pin keeps the version, and Renovate has no release date for it, so the
    // week's wait would hold it for good. The ignored npm preset did the same.
    {
      matchUpdateTypes: ["pin"],
      minimumReleaseAge: null,
    },
    // Majors stay manual.
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    // precompute.py imports the RaMa-Scene engine, which runs on Django 5.
    {
      matchPackageNames: ["django"],
      allowedVersions: "<6",
    },
  ],
}
