{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "command",
	"commandRunner": {
		"command": "FC_SEED=1 node --test"
	},
	"mutate": [
		"flows.js"
	],
	"coverageAnalysis": "off",
	"concurrency": 8,
	"reporters": [
		"clear-text",
		"json"
	],
	"jsonReporter": {
		"fileName": "reports/mutation/mutation.json"
	},
	"cleanTempDir": true,
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 60
	}
}
