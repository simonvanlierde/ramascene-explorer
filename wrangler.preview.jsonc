{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pull request previews only. cloudflare.yml always deploys this file with
  // --name ramascene-explorer-pr-<number>, so the name below is never used. Production is
  // wrangler.jsonc; keep the two in step apart from the name, routes and the two URL settings.
  "name": "ramascene-explorer-preview",
  "main": "hosting/worker.js",
  "compatibility_date": "2026-10-13",
  // Version URLs off, so the workers.dev address is the Worker's only one, and
  // preview-retire.yml can check that one address after the delete.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ramascene-explorer/data/embodied.parquet",
      "/ramascene-explorer/data/browser-engine/store-*/*"
    ],
    "not_found_handling": "none"
  },
  // read only: the Worker serves the Parquet from here, and data.yml writes it
  "r2_buckets": [
    { "binding": "EMBODIED", "bucket_name": "ramascene-explorer-data" }
  ],
  "vars": { "BASE_PATH": "/ramascene-explorer" }
}
