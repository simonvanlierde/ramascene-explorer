{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"files": { "includes": ["**/*.js", "biome.json", "!**/node_modules", "!**/.venv", "!**/dist", "!**/*.tmp.mjs"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"overrides": [
		{
			"includes": ["tests/**", "vite.config.js"],
			"linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
		}
	]
}
